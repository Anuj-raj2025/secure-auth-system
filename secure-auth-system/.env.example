# Copy this file to ".env" and fill in the values.
# (If you skip JWT_SECRET_KEY / ENCRYPTION_KEY the app generates them for you on first run.)

# PostgreSQL connection:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://authuser:authpass@localhost:5432/authdb

# Secret used to sign JWT tokens
JWT_SECRET_KEY=change-me
# Fernet key used to encrypt sensitive fields (phone number)
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
